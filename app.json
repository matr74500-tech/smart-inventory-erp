{
  "expo": {
    "name": "Smart Inventory ERP",
    "slug": "smart-inventory-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/favicon.ico",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "package": "com.smartinventory.erp",
      "permissions": ["CAMERA", "INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "favicon": "./public/favicon.ico"
    }
  }
}
