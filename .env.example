# Supabase Project Settings
# ⚠️ DO NOT commit real secrets. Copy this file to .env and fill in your own values.
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_anon_key
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_anon_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection Parameters
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres

# Direct Database Connection String
# ⚠️ Replace with your own credentials — never commit real passwords
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
